<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <add key="NumFotos" value="4" />
    <add key="Cuenta" value="3" />
    <add key="Camara" value="0" />
    <add key="Texto" value="Mi Evento" />
    <add key="Imprimir" value="true" />
    <add key="Impresora" value="" />
    <add key="DuplicarTira" value="true" />
    <add key="PapelAncho" value="400" />
    <add key="PapelAlto" value="600" />
    <add key="CarpetaFotos" value="" />
    <add key="Espejo" value="true" />
    <add key="SegundosRevision" value="45" />
  </appSettings>
</configuration>
